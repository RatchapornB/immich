# Group 10 - Immich Environment Configuration
# You can find documentation for all the supported env variables
# at https://docs.immich.app/install/environment-variables

IMMICH_VERSION=v3
IMMICH_PORT=2283
URL=http://localhost:2283

UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

DB_USERNAME=postgres
DB_PASSWORD=Group10SecuredPassword2026
DB_DATABASE_NAME=immich

TZ=Asia/Bangkok





